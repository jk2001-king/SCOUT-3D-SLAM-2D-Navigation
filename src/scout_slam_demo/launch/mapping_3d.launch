<?xml version="1.0"?>
<launch>
  <arg name="use_rviz" default="true"/>
  <arg name="scout_port" default="/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller_D-if00-port0"/>
  <arg name="velodyne_ip" default="192.168.10.202"/>
  <arg name="velodyne_port" default="2369"/>
  <arg name="velodyne_x" default="0.34"/>
  <arg name="velodyne_y" default="0.0"/>
  <arg name="velodyne_z" default="0.185"/>
  <arg name="velodyne_yaw" default="0.0"/>
  <arg name="velodyne_pitch" default="0.0"/>
  <arg name="velodyne_roll" default="0.0"/>

  <!-- hdl_graph_slam owns odom -> base_link during mapping. -->
  <include file="$(find scout_slam_demo)/launch/hardware_3d.launch">
    <arg name="scout_port" value="$(arg scout_port)"/>
    <arg name="publish_scout_odom_tf" value="false"/>
    <arg name="scout_odom_topic" value="/scout_odom"/>
    <arg name="velodyne_ip" value="$(arg velodyne_ip)"/>
    <arg name="velodyne_port" value="$(arg velodyne_port)"/>
    <arg name="velodyne_x" value="$(arg velodyne_x)"/>
    <arg name="velodyne_y" value="$(arg velodyne_y)"/>
    <arg name="velodyne_z" value="$(arg velodyne_z)"/>
    <arg name="velodyne_yaw" value="$(arg velodyne_yaw)"/>
    <arg name="velodyne_pitch" value="$(arg velodyne_pitch)"/>
    <arg name="velodyne_roll" value="$(arg velodyne_roll)"/>
  </include>

  <node pkg="nodelet" type="nodelet" name="hdl_prefiltering"
        args="load hdl_graph_slam/PrefilteringNodelet velodyne_nodelet_manager"
        output="screen">
    <remap from="/velodyne_points" to="/velodyne_points"/>
    <param name="base_link_frame" value="base_link"/>
    <param name="use_distance_filter" value="true"/>
    <param name="distance_near_thresh" value="0.8"/>
    <param name="distance_far_thresh" value="50.0"/>
    <param name="downsample_method" value="VOXELGRID"/>
    <param name="downsample_resolution" value="0.10"/>
    <param name="outlier_removal_method" value="NONE"/>
  </node>

  <node pkg="nodelet" type="nodelet" name="hdl_scan_matching_odometry"
        args="load hdl_graph_slam/ScanMatchingOdometryNodelet velodyne_nodelet_manager"
        output="screen">
    <param name="points_topic" value="/velodyne_points"/>
    <param name="published_odom_topic" value="/odom"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="enable_robot_odometry_init_guess" value="false"/>
    <param name="keyframe_delta_trans" value="0.5"/>
    <param name="keyframe_delta_angle" value="0.25"/>
    <param name="keyframe_delta_time" value="2.0"/>
    <param name="transform_thresholding" value="true"/>
    <param name="max_acceptable_trans" value="1.0"/>
    <param name="max_acceptable_angle" value="1.0"/>
    <param name="downsample_method" value="NONE"/>
    <param name="registration_method" value="FAST_GICP"/>
    <param name="reg_num_threads" value="0"/>
    <param name="reg_transformation_epsilon" value="0.01"/>
    <param name="reg_maximum_iterations" value="64"/>
    <param name="reg_max_correspondence_distance" value="2.5"/>
    <param name="reg_correspondence_randomness" value="20"/>
  </node>

  <node pkg="nodelet" type="nodelet" name="hdl_graph_slam"
        args="load hdl_graph_slam/HdlGraphSlamNodelet velodyne_nodelet_manager"
        output="screen">
    <param name="points_topic" value="/velodyne_points"/>
    <param name="published_odom_topic" value="/odom"/>
    <param name="map_frame_id" value="map"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="enable_gps" value="false"/>
    <param name="enable_imu_acceleration" value="false"/>
    <param name="enable_imu_orientation" value="false"/>
    <param name="g2o_solver_type" value="lm_var_cholmod"/>
    <param name="g2o_solver_num_iterations" value="256"/>
    <param name="max_keyframes_per_update" value="10"/>
    <param name="keyframe_delta_trans" value="1.0"/>
    <param name="keyframe_delta_angle" value="0.5"/>
    <param name="fix_first_node" value="true"/>
    <param name="fix_first_node_adaptive" value="true"/>
    <param name="distance_thresh" value="15.0"/>
    <param name="accum_distance_thresh" value="25.0"/>
    <param name="min_edge_interval" value="5.0"/>
    <param name="fitness_score_thresh" value="0.5"/>
    <param name="registration_method" value="FAST_GICP"/>
    <param name="reg_num_threads" value="4"/>
    <param name="reg_maximum_iterations" value="64"/>
    <param name="reg_max_correspondence_distance" value="2.5"/>
    <param name="reg_correspondence_randomness" value="20"/>
    <param name="loop_closure_edge_robust_kernel" value="Huber"/>
    <param name="loop_closure_edge_robust_kernel_size" value="1.0"/>
    <param name="graph_update_interval" value="3.0"/>
    <param name="map_cloud_update_interval" value="5.0"/>
    <param name="map_cloud_resolution" value="0.10"/>
  </node>

  <node pkg="hdl_graph_slam" type="map2odom_publisher.py"
        name="hdl_map_to_odom" output="screen">
    <param name="map_frame_id" value="map"/>
    <param name="odom_frame_id" value="odom"/>
  </node>

  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        output="screen" args="-d $(find scout_slam_demo)/config/mapping_3d.rviz"/>
</launch>
